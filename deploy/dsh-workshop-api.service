[Unit]
Description=DSH Creative Workshop Marketplace API
After=network.target

[Service]
Type=simple
User=dsh-workshop
Group=dsh-workshop
WorkingDirectory=/opt/dsh-creative-workshop
Environment=NODE_ENV=production
Environment=WORKSHOP_API_HOST=127.0.0.1
Environment=WORKSHOP_API_PORT=4100
Environment=WORKSHOP_ALLOWED_ORIGINS=https://xxnmkk.xyz,https://www.xxnmkk.xyz
Environment=WORKSHOP_DATA_FILE=/var/lib/dsh-workshop/data.json
EnvironmentFile=-/etc/dsh-workshop/api.env
ExecStart=/usr/bin/node /opt/dsh-creative-workshop/apps/api/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=dsh-workshop
StateDirectoryMode=0700
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
