{
  "name": "@dsh-workshop/api",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --external:fastify --external:@fastify/cors --external:yaml --outfile=dist/server.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-workshop/catalog": "workspace:*",
    "@dsh-workshop/domain": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.6.2",
    "yaml": "^2.8.2"
  }
}
