{
  "name": "dsh-creative-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @dsh-workshop/api --filter @dsh-workshop/companion --filter @dsh-workshop/web dev",
    "dev:api": "pnpm --filter @dsh-workshop/api dev",
    "dev:companion": "pnpm --filter @dsh-workshop/companion dev",
    "dev:web": "pnpm --filter @dsh-workshop/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "validate:manifest": "tsx scripts/validate-manifest.ts"
  },
  "devDependencies": {
    "@dsh-workshop/manifest": "workspace:*",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
